{
  "name": "academia-okajima",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3334",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . --formatter-enabled=false --assist-enabled=false",
    "check": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:pull": "prisma db pull && prisma validate && prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "node scripts/prisma-studio.mjs",
    "test": "node --conditions=react-server --import tsx --test tests/auth/auth.test.ts tests/auth/remembered-identifier.test.ts tests/home/catalog.test.ts tests/home/module-progress.test.ts tests/home/navigation.test.ts tests/home/video-progress-rules.test.ts tests/studio/content-upload-view.test.ts tests/studio/stats.test.ts tests/studio/video-upload-lifecycle.test.ts tests/vimeo/webhooks.test.ts",
    "test:db": "node --env-file=.env.local --conditions=react-server --import tsx --test tests/auth/database.test.ts",
    "test:http": "node --env-file=.env.local --conditions=react-server --import tsx --test tests/auth/http.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tabler/core": "^1.5.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@vimeo/player": "^2.30.4",
    "antd": "^6.6.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "dotenv": "^17.4.2",
    "kysely": "^0.29.5",
    "lucide-react": "^1.45.0",
    "mysql2": "^3.24.3",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
