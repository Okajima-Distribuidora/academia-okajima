// Analytics retain scalar identities deliberately: deleting an account/video must not cascade into history.
model academy_video_watch_sessions {
  id               String  @id @db.VarChar(36)
  user_id          Int
  video_id         Int
  status           String  @default("active") @db.VarChar(12)
  started_at_ms    BigInt
  last_seen_at_ms  BigInt
  expires_at_ms    BigInt
  ended_at_ms      BigInt?
  last_sequence    Int     @default(0)
  watched_ms       Int     @default(0)
  accepted_buckets String  @db.LongText

  @@index([user_id, status, last_seen_at_ms], map: "watch_sessions_user_active_idx")
  @@index([video_id, started_at_ms], map: "watch_sessions_video_started_idx")
  @@index([status, ended_at_ms], map: "watch_sessions_ended_idx")
}

model academy_video_watch_hourly {
  user_id       Int
  video_id      Int
  hour_start_ms BigInt
  watched_ms    BigInt @default(0)

  @@id([user_id, video_id, hour_start_ms])
  @@index([video_id, hour_start_ms], map: "watch_hourly_video_hour_idx")
  @@index([hour_start_ms], map: "watch_hourly_hour_idx")
  @@index([user_id, hour_start_ms], map: "watch_hourly_user_hour_idx")
}

model academy_video_watch_daily {
