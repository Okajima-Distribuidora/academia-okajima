generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

model activities {
  id      Int    @id @default(autoincrement())
  user_id Int    @default(0)
  text    String @default("") @db.VarChar(300)
  image   String @default("") @db.VarChar(300)
  time    String @default("") @db.VarChar(50)
}

model admininvitations {
  id     Int    @id @default(autoincrement())
  code   String @default("0") @db.VarChar(300)
  posted String @default("0") @db.VarChar(50)
  status Int    @default(0)

  @@index([code(length: 255)], map: "code")
}

model ads_transactions {
  id          Int    @id @default(autoincrement())
  ad_id       Int    @default(0)
  video_owner Int    @default(0)
  amount      String @default("0") @db.VarChar(11)
  type        String @default("") @db.VarChar(50)
  time        String @default("") @db.VarChar(100)
}

model announcement_views {
  id              Int @id @default(autoincrement())
  user_id         Int @default(0)
  announcement_id Int @default(0)

  @@index([announcement_id], map: "announcement_id")
  @@index([user_id], map: "user_id")
}

model announcements {
  id     Int     @id @default(autoincrement())
  text   String? @db.Text
  time   Int     @default(0)
  active Int     @default(1)

  @@index([active], map: "active")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model app_login {
  CODIGORCA  Int?
  NOMERCA    String?   @db.VarChar(255)
  CODIGOSV   Int?
  NOMESV     String?   @db.VarChar(255)
  CODIGOCV   Int?
  NOMECV     String?   @db.VarChar(255)
  CODIGOGV   Int?
  NOMEGV     String?   @db.VarChar(255)
  CODMOD     Int?
  MODELO     String?   @db.VarChar(255)
  FAIXA      String?   @db.VarChar(255)
  SENHA      String?   @db.VarChar(255)
  FUNCAO     String?   @db.VarChar(255)
  CPF        String?   @db.VarChar(14)
  EMAIL      String?   @db.VarChar(255)
  STATUS     String?   @db.VarChar(50)
  DATAINICIO DateTime? @db.Date
  DATAFIM    DateTime? @db.Date
  PERFIL     String?   @db.VarChar(255)
  TELEFONE   String?   @db.VarChar(20)
  is_hashed  Int?      @default(0) @db.TinyInt

  @@ignore
}

model apps {
  id               Int    @id @default(autoincrement())
  app_user_id      Int    @default(0)
  app_name         String @db.VarChar(32)
  app_website_url  String @db.VarChar(55)
  app_description  String @db.Text
  app_avatar       String @default("upload/photos/app-default-icon.png") @db.VarChar(100)
  app_callback_url String @db.VarChar(255)
  app_id           String @db.VarChar(32)
  app_secret       String @db.VarChar(55)
  active           Int    @default(1)

  @@index([active], map: "active")
  @@index([app_id], map: "app_id")
  @@index([app_user_id], map: "app_user_id")
}

model apps_codes {
  id      Int    @id @default(autoincrement())
  code    String @default("") @db.VarChar(50)
  app_id  String @default("") @db.VarChar(50)
  user_id Int    @default(0)
  time    Int    @default(0)

  @@index([app_id], map: "app_id")
  @@index([code], map: "code")
  @@index([user_id], map: "user_id")
}

model apps_permission {
  id      Int @id @default(autoincrement())
  user_id Int
  app_id  Int

  @@index([user_id, app_id], map: "user_id")
}

model backup_codes {
  id      Int    @id @default(autoincrement())
  user_id Int    @default(0)
  codes   String @default("") @db.VarChar(500)

  @@index([user_id], map: "user_id")
}

model bad_login {
  id   Int    @id @default(autoincrement())
  ip   String @default("") @db.VarChar(100)
  time Int    @default(0)

  @@index([ip], map: "ip")
  @@index([time], map: "time")
}

model bank_receipts {
  id           Int    @id @default(autoincrement()) @db.UnsignedInt
  user_id      Int    @default(0) @db.UnsignedInt
  profile_id   Int    @default(0)
  video_id     Int    @default(0)
  description  String @db.TinyText
  price        String @default("0") @db.VarChar(50)
  mode         String @default("") @db.VarChar(50)
  approved     Int    @default(0) @db.UnsignedInt
  receipt_file String @default("") @db.VarChar(250)
  created_at   String @default("") @db.VarChar(50)
  approved_at  Int    @default(0) @db.UnsignedInt
}

model banned {
  id         Int     @id @default(autoincrement())
  ip_address String? @default("") @db.VarChar(100)
  time       String  @default("") @db.VarChar(50)
}

model block {
  id         Int    @id @default(autoincrement())
  user_id    Int    @default(0)
  blocked_id Int    @default(0)
  time       String @default("") @db.VarChar(50)

  @@index([blocked_id], map: "blocked_id")
  @@index([user_id], map: "user_id")
}

model cards {
  id               Int     @id @default(autoincrement())
  video_id         Int     @default(0)
  user_id          Int     @default(0)
  ref_video        Int     @default(0)
  title            String  @default("") @db.VarChar(300)
  url              String? @db.Text
  duration         String  @default("00:00") @db.VarChar(33)
  color            String  @default("") @db.VarChar(100)
  background_color String  @default("") @db.VarChar(100)
  type             String  @default("") @db.VarChar(100)
  part             String  @default("") @db.VarChar(100)
  time             Int     @default(0)

  @@index([part], map: "part")
  @@index([ref_video], map: "ref_video")
  @@index([type], map: "type")
  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
}

model comm_replies {
  id         Int     @id @default(autoincrement())
  user_id    Int     @default(0)
  comment_id Int     @default(0)
  video_id   Int     @default(0)
  post_id    Int     @default(0)
  text       String? @db.Text
  time       String  @default("0") @db.VarChar(50)
}

model comments {
  id          Int     @id @default(autoincrement())
  user_id     Int     @default(0)
  video_id    Int?    @default(0)
  post_id     Int     @default(0)
  activity_id Int     @default(0)
  text        String? @db.Text
  time        Int     @default(0)
  pinned      Int?    @default(0)
  likes       Int     @default(0)
  dis_likes   Int     @default(0)

  @@index([dis_likes], map: "dis_likes")
  @@index([likes], map: "likes")
  @@index([post_id], map: "post_id")
  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
}

model comments_likes {
  id         Int @id @default(autoincrement())
  user_id    Int @default(0)
  comment_id Int @default(0)
  reply_id   Int @default(0)
  video_id   Int @default(0)
  post_id    Int @default(0)
  time       Int @default(0)
  type       Int @default(1)

  @@index([comment_id], map: "comment_id")
  @@index([post_id], map: "post_id")
  @@index([reply_id], map: "reply_id")
  @@index([type], map: "type")
  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
}

model config {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(100)
  value String @db.VarChar(20000)

  @@index([name], map: "name")
  @@index([value(length: 255)], map: "value")
}

model conversations {
  id       Int @id @default(autoincrement())
  user_one Int @default(0)
  user_two Int @default(0)
  time     Int @default(0)

  @@index([time], map: "time")
  @@index([user_one], map: "user_one")
  @@index([user_two], map: "user_two")
}

model copyright_report {
  id       Int    @id @default(autoincrement())
  video_id Int    @default(0)
  user_id  Int    @default(0)
  text     String @default("") @db.VarChar(300)
  time     String @default("") @db.VarChar(50)

  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
}

model custom_pages {
  id           Int     @id @default(autoincrement())
  page_name    String  @default("") @db.VarChar(50)
  page_title   String  @default("") @db.VarChar(200)
  page_content String? @db.Text
  page_type    Int     @default(0)
}

model dashboard_reports {
  id    Int    @id @default(autoincrement())
  name  String @default("") @db.VarChar(50)
  value String @default("") @db.VarChar(1000)

  @@index([name], map: "name")
}

model faqs {
  id       Int     @id @default(autoincrement())
  question String  @default("") @db.VarChar(100)
  answer   String? @db.Text
  time     Int     @default(0)
}

model hashtags {
  id   Int    @id @default(autoincrement())
  tag  String @default("") @db.VarChar(200)
  time Int    @default(0)

  @@index([tag], map: "tag")
  @@index([time], map: "time")
}

model history {
  id       Int @id @default(autoincrement())
  user_id  Int @default(0)
  video_id Int @default(0)
  time     Int @default(0)

  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
}

model invitation_links {
  id         Int    @id @default(autoincrement())
  user_id    Int    @default(0)
  invited_id Int    @default(0)
  code       String @default("") @db.VarChar(300)
  time       Int    @default(0)

  @@index([code], map: "code")
  @@index([invited_id], map: "invited_id")
  @@index([time], map: "time")
  @@index([user_id], map: "user_id")
}

model lang_iso {
  id        Int    @id @default(autoincrement())
  lang_name String @default("") @db.VarChar(100)
  iso       String @default("") @db.VarChar(50)
  image     String @default("") @db.VarChar(300)
  status    Int    @default(1)

  @@index([image], map: "image")
  @@index([iso], map: "iso")
  @@index([lang_name], map: "lang_name")
  @@index([status], map: "status")
}

model langs {
  id       Int     @id @default(autoincrement())
  lang_key String? @db.VarChar(160)
  type     String  @default("") @db.VarChar(100)
  english  String? @db.LongText

  @@index([lang_key], map: "lang_key")
}

model likes_dislikes {
  id          Int @id @default(autoincrement())
  user_id     Int @default(0)
  video_id    Int @default(0)
  post_id     Int @default(0)
  activity_id Int @default(0)
  type        Int @default(0)
  time        Int @default(0)

  @@index([post_id], map: "post_id")
  @@index([type], map: "type")
  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
}

model lists {
  id          Int    @id @default(autoincrement())
  list_id     String @default("") @db.VarChar(300)
  user_id     Int    @default(0)
  name        String @default("") @db.VarChar(100)
  description String @default("") @db.VarChar(500)
  privacy     Int    @default(1)
  views       Int    @default(0)
  icon        String @default("") @db.VarChar(3000)
  time        Int    @default(0)

  @@index([list_id(length: 255)], map: "list_id")
  @@index([privacy], map: "privacy")
  @@index([user_id], map: "user_id")
}

model live_sub_users {
  id          Int @id @default(autoincrement())
  user_id     Int @default(0)
  post_id     Int @default(0)
  is_watching Int @default(0)
  time        Int @default(0)

  @@index([is_watching], map: "is_watching")
  @@index([post_id], map: "post_id")
  @@index([time], map: "time")
  @@index([user_id], map: "user_id")
}

model manage_pro {
  id              Int    @id @default(autoincrement())
  type            String @default("") @db.VarChar(100)
  price           Float  @default(0) @db.Float
  featured_videos Int    @default(0)
  verified_badge  Int    @default(0)
  discount        Int    @default(0)
  image           String @default("") @db.VarChar(300)
  night_image     String @default("") @db.VarChar(300)
  color           String @default("#fafafa") @db.VarChar(50)
  description     String @default("") @db.VarChar(1000)
  status          Int    @default(1)
  time            String @default("month") @db.VarChar(20)
  time_count      Int    @default(1)
  max_upload      String @default("96000000") @db.VarChar(100)
  features        String @default("{\"can_use_article\":1,\"can_use_playlist\":1,\"can_use_post\":1,\"can_use_payed_subscribers\":1,\"can_use_donate\":1,\"can_use_invite_links\":1,\"can_use_point\":1,\"can_use_upload\":1,\"can_use_import\":1,\"can_use_youtube_short\":1,\"can_use_ok_import\":1,\"can_use_facebook_import\":1,\"can_use_instagram_import\":1,\"can_use_twitch_import\":1,\"can_use_tiktok_import\":1,\"can_use_embed_videos\":1,\"can_use_trailer_system\":1,\"can_use_restrict_embedding\":1,\"can_use_video_text\":1,\"can_use_stock_videos\":1,\"can_use_download_videos\":1,\"can_use_movies_videos\":1,\"can_use_geo_blocking\":1,\"can_use_shorts\":1,\"can_use_hashtag\":1,\"can_use_sell_videos\":1,\"can_use_rent_videos\":1,\"can_use_live_video\":1,\"can_use_live_save\":1,\"can_use_user_ads\":1,\"can_use_usr_v_mon\":1,\"can_use_affiliate\":1,\"can_use_affiliate_new_user\":1,\"can_use_affiliate_pro\":1,\"can_use_affiliate_subscribe\":1,\"can_use_affiliate_buy_rent\":1,\"can_use_pro_google\":1}") @db.VarChar(1000)

  @@index([color], map: "color")
  @@index([discount], map: "discount")
  @@index([featured_videos], map: "featured_videos")
  @@index([features], map: "features")
  @@index([image], map: "image")
  @@index([max_upload], map: "max_upload")
  @@index([night_image], map: "night_image")
  @@index([price], map: "price")
  @@index([status], map: "status")
  @@index([time], map: "time")
  @@index([time_count], map: "time_count")
  @@index([type], map: "type")
  @@index([verified_badge], map: "verified_badge")
}

model messages {
  id           Int     @id @default(autoincrement())
  from_id      Int     @default(0)
  to_id        Int     @default(0)
  text         String? @db.Text
  seen         Int     @default(0)
  time         Int     @default(0)
  from_deleted Int     @default(0)
  to_deleted   Int     @default(0)

  @@index([from_deleted], map: "from_deleted")
  @@index([from_id], map: "from_id")
  @@index([seen], map: "seen")
  @@index([time], map: "time")
  @@index([to_deleted], map: "to_deleted")
  @@index([to_id], map: "to_id")
}

model monetization_requests {
  id             Int    @id @default(autoincrement())
  user_id        Int    @default(0)
  name           String @default("") @db.VarChar(100)
  message        String @default("") @db.VarChar(600)
  personal_photo String @default("") @db.VarChar(300)
  id_photo       String @default("") @db.VarChar(300)
  time           String @default("") @db.VarChar(50)

  @@index([user_id], map: "user_id")
}

model not_interested {
  id       Int @id @default(autoincrement())
  user_id  Int @default(0)
  video_id Int @default(0)
  time     Int @default(0)

  @@index([time], map: "time")
  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
}

model notifications {
  id           Int     @id @default(autoincrement())
  notifier_id  Int     @default(0)
  recipient_id Int     @default(0)
  video_id     Int     @default(0)
  type         String  @default("") @db.VarChar(50)
  text         String? @db.Text
  url          String  @default("") @db.VarChar(3000)
  seen         String  @default("0") @db.VarChar(50)
  time         String  @default("0") @db.VarChar(50)
  sent_push    Int     @default(0)
  full_link    String  @default("") @db.VarChar(1000)
  admin        Int     @default(0)

  @@index([admin], map: "admin")
  @@index([notifier_id], map: "notifier_id")
  @@index([recipient_id], map: "recipient_id")
  @@index([seen], map: "seen")
  @@index([sent_push], map: "sent_push")
  @@index([time], map: "time")
  @@index([type], map: "type")
  @@index([video_id], map: "video_id")
}

model payments {
  id      Int    @id @default(autoincrement())
  user_id Int    @default(0)
  type    String @default("") @db.VarChar(200)
  amount  Int    @default(0)
  date    String @default("") @db.VarChar(100)
  expire  String @default("") @db.VarChar(30)

  @@index([amount], map: "amount")
  @@index([expire], map: "expire")
  @@index([type], map: "type")
  @@index([user_id], map: "user_id")
}

model pending_payments {
  id           Int    @id @default(autoincrement())
  user_id      Int    @default(0)
  payment_data String @default("") @db.VarChar(500)
  method_name  String @default("") @db.VarChar(100)
  time         Int    @default(0)

  @@index([method_name], map: "method_name")
  @@index([payment_data], map: "payment_data")
  @@index([time], map: "time")
  @@index([user_id], map: "user_id")
}

model play_list {
  id       Int    @id @default(autoincrement())
  list_id  String @default("") @db.VarChar(500)
  video_id String @default("") @db.VarChar(500)
  user_id  Int    @default(0)

  @@index([list_id(length: 255)], map: "list_id")
  @@index([video_id(length: 255)], map: "video_id")
}

model playlist_subscribers {
  id            Int    @id @default(autoincrement())
  list_id       String @default("") @db.VarChar(50)
  subscriber_id Int    @default(0)
  time          Int    @default(0)
  active        Int    @default(1)

  @@index([active], map: "active")
  @@index([subscriber_id], map: "subscriber_id")
  @@index([list_id], map: "user_id")
}

model profile_fields {
  id                Int     @id @default(autoincrement())
  name              String  @default("") @db.VarChar(50)
  description       String? @db.Text
  options           String  @default("") @db.VarChar(3000)
  type              String? @db.Text
  length            Int     @default(0)
  placement         String  @default("profile") @db.VarChar(32)
  registration_page Int     @default(0)
  profile_page      Int     @default(0)
  active            Int     @default(0)

  @@index([active], map: "active")
  @@index([profile_page], map: "profile_page")
  @@index([registration_page], map: "registration_page")
}

model pt_posts {
  id          Int     @id @default(autoincrement())
  title       String  @default("") @db.VarChar(300)
  description String  @default("") @db.VarChar(500)
  category    String  @default("") @db.VarChar(100)
  image       String  @default("") @db.VarChar(3000)
  text        String? @db.Text
  tags        String  @default("") @db.VarChar(500)
  time        String  @default("0") @db.VarChar(50)
  user_id     Int     @default(0)
  active      Int     @default(0)
  views       Int     @default(0)
  shared      Int     @default(0)

  @@index([active], map: "active")
  @@index([title(length: 255)], map: "title")
  @@index([user_id], map: "user_id")
  @@index([views], map: "views")
}

model queue {
  id         Int    @id @default(autoincrement())
  video_id   Int    @default(0)
  video_res  String @default("") @db.VarChar(20)
  processing Int    @default(0)

  @@index([processing], map: "processing")
  @@index([video_id], map: "video_id")
  @@index([video_res], map: "video_res")
}

model reports {
  id         Int     @id @default(autoincrement())
  video_id   Int     @default(0)
  article_id Int     @default(0)
  ad_id      Int     @default(0)
  comment_id Int     @default(0)
  reply_id   Int     @default(0)
  profile_id Int     @default(0)
  user_id    Int     @default(0)
  text       String? @db.Text
  time       String  @default("") @db.VarChar(50)
  seen       Int     @default(0)
  type       String  @default("") @db.VarChar(100)

  @@index([ad_id], map: "ad_id")
  @@index([article_id], map: "article_id")
  @@index([profile_id], map: "profile_id")
  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
}

model saved_videos {
  id       Int @id @default(autoincrement())
  user_id  Int @default(0)
  video_id Int @default(0)
  time     Int @default(0)

  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
}

model sessions {
  id               Int     @id @default(autoincrement())
  session_id       String  @default("") @db.VarChar(100)
  user_id          Int     @default(0)
  platform         String  @default("web") @db.VarChar(30)
  platform_details String? @db.Text
  time             Int     @default(0)

  @@index([platform], map: "platform")
  @@index([session_id], map: "session_id")
  @@index([time], map: "time")
  @@index([user_id], map: "user_id")
}

model site_ads {
  id        Int     @id @default(autoincrement())
  placement String  @default("") @db.VarChar(50)
  code      String? @db.Text
  active    Int     @default(0)

  @@index([active], map: "active")
  @@index([placement], map: "placement")
}

model subscriptions {
  id            Int @id @default(autoincrement())
  user_id       Int @default(0)
  subscriber_id Int @default(0)
  time          Int @default(0)
  active        Int @default(0)
  notify        Int @default(0)

  @@index([active], map: "active")
  @@index([notify], map: "notify")
  @@index([subscriber_id], map: "subscriber_id")
  @@index([user_id], map: "user_id")
}

model terms {
  id   Int     @id @default(autoincrement())
  type String  @db.VarChar(400)
  text String? @db.Text
}

model typings {
  id       Int @id @default(autoincrement())
  user_one Int @default(0)
  user_two Int @default(0)
  time     Int @default(0)

  @@index([time], map: "time")
  @@index([user_one], map: "user_one")
  @@index([user_two], map: "user_two")
}

model uploaded_chunks {
  id         Int      @id @default(autoincrement())
  user_id    Int      @default(0)
  filename   String   @default("") @db.VarChar(200)
  folderpath String   @default("") @db.VarChar(200)
  status     String   @default("pending") @db.VarChar(20)
