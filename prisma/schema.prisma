  @@id([user_id, video_id, day])
  @@index([video_id, day], map: "watch_daily_video_day_idx")
  @@index([day], map: "watch_daily_day_idx")
  @@index([user_id, day], map: "watch_daily_user_day_idx")
}

model academy_video_progress {
  id                        Int       @id @default(autoincrement())
  user_id                   Int
  video_id                  Int
  resume_position_seconds   Int       @default(0)
  furthest_position_seconds Int       @default(0)
  completed_at              DateTime? @db.DateTime(0)
  last_watched_at           DateTime  @default(now()) @db.DateTime(0)
  created_at                DateTime  @default(now()) @db.DateTime(0)
  updated_at                DateTime  @updatedAt @db.DateTime(0)
  user                      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  video                     videos    @relation(fields: [video_id], references: [id], onDelete: Cascade)

  @@unique([user_id, video_id], map: "academy_video_progress_user_video_unique")
  @@index([user_id, last_watched_at], map: "academy_video_progress_user_last_watched_idx")
  @@index([video_id], map: "academy_video_progress_video_idx")
}

