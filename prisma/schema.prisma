  sort_order    Int                     @default(0)
  is_active     Boolean                 @default(true)
  created_at    DateTime                @default(now()) @db.DateTime(0)
  updated_at    DateTime                @updatedAt @db.DateTime(0)
  subcategories academy_subcategories[]

  @@index([is_active, sort_order], map: "academy_categories_active_sort_idx")
}

model academy_subcategories {
  id          Int                           @id @default(autoincrement())
  category_id Int
  name        String                        @db.VarChar(120)
  slug        String                        @db.VarChar(140)
  description String?                       @db.VarChar(500)
  sort_order  Int                           @default(0)
  is_active   Boolean                       @default(true)
  created_at  DateTime                      @default(now()) @db.DateTime(0)
  updated_at  DateTime                      @updatedAt @db.DateTime(0)
  category    academy_categories            @relation(fields: [category_id], references: [id], onDelete: Cascade, map: "academy_subcategories_category_fk")
  videos      academy_video_subcategories[]

  @@unique([category_id, slug], map: "academy_subcategories_category_slug_unique")
  @@index([category_id, is_active, sort_order], map: "academy_subcategories_category_active_sort_idx")
}

model academy_video_subcategories {
  video_id       Int
  subcategory_id Int
  created_at     DateTime              @default(now()) @db.DateTime(0)
  subcategory    academy_subcategories @relation(fields: [subcategory_id], references: [id], onDelete: Cascade, map: "academy_video_subcategories_subcategory_fk")
  video          videos                @relation(fields: [video_id], references: [id], onDelete: Cascade, map: "academy_video_subcategories_video_fk")

  @@id([video_id, subcategory_id])
  @@index([subcategory_id], map: "academy_video_subcategories_subcategory_idx")
}

model videos_transactions {
  id        Int    @id @default(autoincrement())
  user_id   Int    @default(0)
  paid_id   Int    @default(0)
  video_id  Int    @default(0)
  amount    String @default("0") @db.VarChar(11)
  admin_com String @default("0") @db.VarChar(11)
  currency  String @default("USD") @db.VarChar(11)
  time      String @default("0") @db.VarChar(50)
  type      String @default("") @db.VarChar(50)
}

model views {
  id          Int    @id @default(autoincrement())
  video_id    Int    @default(0)
  fingerprint String @default("") @db.VarChar(300)
  user_id     Int    @default(0)
  time        Int    @default(0)

  @@index([fingerprint(length: 255)], map: "fingerprint")
  @@index([time], map: "time")
  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
  @@index([video_id, time], map: "video_id_2")
  @@index([user_id, video_id, time], map: "views_user_video_time_idx")
}

model watch_later {
  id       Int    @id @default(autoincrement())
  user_id  Int    @default(0)
  video_id Int    @default(0)
  time     String @default("") @db.VarChar(50)

  @@index([user_id], map: "user_id")
  @@index([video_id], map: "video_id")
}

model withdrawal_requests {
  id            Int    @id @default(autoincrement())
  user_id       Int    @default(0)
  email         String @default("") @db.VarChar(200)
  amount        String @default("0") @db.VarChar(100)
  currency      String @default("") @db.VarChar(20)
  iban          String @default("") @db.VarChar(250)
  country       String @default("") @db.VarChar(100)
  full_name     String @default("") @db.VarChar(150)
  swift_code    String @default("") @db.VarChar(100)
  address       String @default("") @db.VarChar(600)
  transfer_info String @default("") @db.VarChar(600)
  type          String @default("") @db.VarChar(100)
  requested     String @default("") @db.VarChar(100)
  status        Int    @default(0)
}
